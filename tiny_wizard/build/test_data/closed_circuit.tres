[gd_resource type="Resource" script_class="BuildSynergyDefinition" load_steps=4 format=3]

[ext_resource type="Script" path="res://tiny_wizard/build/build_synergy_definition.gd" id="1_synergy"]
[ext_resource type="Script" path="res://tiny_wizard/build/build_tag_requirement.gd" id="2_requirement"]
[ext_resource type="Script" path="res://tiny_wizard/build/build_stat_modifier.gd" id="3_modifier"]

[sub_resource type="Resource" id="Resource_requirement"]
script = ExtResource("2_requirement")
tag = &"bioelectric"
comparison = 0
count = 2

[sub_resource type="Resource" id="Resource_modifier"]
script = ExtResource("3_modifier")
stat_id = &"move_speed"
operation = 0
value = 25.0

[resource]
script = ExtResource("1_synergy")
id = &"synergy.closed_circuit"
display_name = "闭合回路"
description = "拥有至少两个生物电标签时满足配置条件。"
tag_requirements = Array[ExtResource("2_requirement")]([SubResource("Resource_requirement")])
stat_modifiers = Array[ExtResource("3_modifier")]([SubResource("Resource_modifier")])
