[ext_resource type="Script" path="res://tiny_wizard/build/build_tag_requirement.gd" id="2_req"]

[sub_resource type="Resource" id="Resource_protomatter_req"]
script = ExtResource("2_req")
tag = &"protomatter"
min_count = 2
max_count = -1

[resource]
script = ExtResource("1_syn")
synergy_id = &"tiemu_spine_growth"
